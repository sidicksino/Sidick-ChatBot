# --- Which AI answers: "ollama" (local models, needs ~4GB RAM) or "openai" (a hosted API: Groq, xAI...) ---
LLM_PROVIDER=ollama

# --- Hosted API (only when LLM_PROVIDER=openai). Get a free key at https://console.groq.com/keys ---
# LLM_API_KEY=your_groq_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# For xAI's Grok instead: LLM_BASE_URL=https://api.x.ai/v1 and LLM_MODEL=<a grok model id>

# --- Ollama models (only when LLM_PROVIDER=ollama; downloaded automatically on first start) ---
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3
# Local runs use http://localhost:11434; Docker sets this itself.
# OLLAMA_URL=http://localhost:11434

# --- Server (deployment) ---
# Your free DuckDNS name (or any domain) pointing at the server's IP. Caddy gets HTTPS for it.
DOMAIN=sidick-bot.duckdns.org
# Sites allowed to call the API (comma-separated). Add http://localhost:5173 etc. to test locally.
ALLOWED_ORIGINS=https://www.sidickabdoulaye.com,https://sidickabdoulaye.com
# RATE_PER_MINUTE=6
# RATE_PER_DAY=60
# GLOBAL_PER_DAY=500
# MAX_ANSWER_TOKENS=350
# Questions matching the knowledge below this score are declined as off-topic (no LLM call).
# Lower it if real questions about you get declined; raise it if off-topic ones get through.
# OFFTOPIC_THRESHOLD=0.465

# --- Optional: lets ingest_github.py read all your READMEs ---
# GITHUB_TOKEN=your_github_token
# GITHUB_USER=sidicksino
